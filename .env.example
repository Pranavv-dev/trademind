# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=trademind
DB_USER=trademind
DB_PASSWORD=trademind_dev
DATABASE_URL=postgresql+asyncpg://trademind:trademind_dev@db:5432/trademind

# Redis
REDIS_URL=redis://redis:6379/0

# Zerodha Kite Connect
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/api/auth/kite/callback

# Zerodha UNATTENDED auto-login (so the system runs 9:15-15:30 IST without you
# clicking the login URL each morning). A Celery task logs in via TOTP at 8:00 AM IST.
# SECURITY: stores your Zerodha password + TOTP secret. Keep this file gitignored.
# To get KITE_TOTP_SECRET: Zerodha Console → set up an external authenticator
# (Google Authenticator / Authy) — the base32 secret under the QR code is the value.
# (NOT the rotating 6-digit code — the static secret used to generate it.)
KITE_AUTO_AUTH_ENABLED=false
KITE_USER_ID=AB1234
KITE_PASSWORD=your_kite_login_password
KITE_TOTP_SECRET=your_base32_totp_secret
BACKEND_INTERNAL_URL=http://backend:5000

# Gemini API
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# Notifications
# Telegram (leave blank if unavailable in your region)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Discord webhook (recommended alternative). In Discord: Server → a channel →
# Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# App Config
TRADING_MODE=paper
DEFAULT_CAPITAL=200000
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
